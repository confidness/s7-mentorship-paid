# Copy to .env.local for development, or set these in the Vercel dashboard.
#
# The VITE_ prefix is the line between public and secret, and it is not a style choice:
# anything carrying it is inlined into the client bundle at build time and readable by anyone
# with devtools. Keys below without the prefix must never gain one.

# ---------------------------------------------------------------- database & auth
# The project URL and anon key are public by design — row level security is what actually
# decides what they can reach, so they are safe in the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The same URL again for the server, plus the service-role key. The service role BYPASSES
# row level security entirely: it is what lets the Stripe webhook write an entitlement that
# no user is allowed to write. Treat it like a root password. Never prefix it with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------- payments
# Secret key: creates Checkout Sessions and Connect accounts. Server only.
STRIPE_SECRET_KEY=sk_test_...

# Signs webhook events. Without it the webhook cannot verify that a payment notice really
# came from Stripe, so it refuses every request rather than trusting an anonymous POST.
# Get it from `stripe listen` locally, or the dashboard endpoint in production.
STRIPE_WEBHOOK_SECRET=whsec_...

# Publishable key — public, hence the prefix.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# The platform's cut, in basis points: 10000 = 100%, so 2000 is 20%. Anything outside
# 0..10000 is ignored and the 20% default applies.
PLATFORM_FEE_BPS=2000

# Where Stripe sends people back to after checkout and Connect onboarding. Falls back to the
# request's own origin, which is usually right — set it when running behind a proxy.
PUBLIC_SITE_URL=https://your-deployment.vercel.app

# ---------------------------------------------------------------- AI mentor
# Either key works; OpenRouter wins when both are set. Neither being present is a normal
# state — the mentor falls back to its built-in knowledge base.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=
